APP_NAME=NetGlance
# NetAlertX GraphQL/API base (host:port). Per API_GRAPHQL.md: POST /graphql. Trailing /docs or /graphql is stripped.
NETALERTX_BASE_URL=http://netalertx:20211
# Required for device rename (NetAlertX POST /device/.../set-alias) and when API auth is enabled.
NETALERTX_API_TOKEN=
# Optional devices(options) "status" filter: my_devices | connected | favorites | new | down | archived | offline
# NETALERTX_GRAPHQL_DEVICE_STATUS=
# Optional page size for GraphQL devices pagination (default 500, max 1000).
# NETALERTX_GRAPHQL_PAGE_LIMIT=500
POLL_INTERVAL_SECONDS=30
SQLITE_DB_PATH=/app/data/netglance.sqlite
APP_BASE_URL=http://localhost:3030
ENABLE_SOUND_ALERTS=false
ENABLE_DEMO_MODE=false
